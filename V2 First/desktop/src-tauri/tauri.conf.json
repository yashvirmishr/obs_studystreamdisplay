{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Stream 2.0",
  "version": "0.1.0",
  "identifier": "com.yashvir.studystream2",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Study Stream 2.0",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/studystream-backend"
    ],
    "icon": ["icons/icon.ico"]
  }
}
