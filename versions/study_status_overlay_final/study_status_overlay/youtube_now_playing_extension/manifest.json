{
  "manifest_version": 3,
  "name": "Study Stream YouTube Now Playing",
  "version": "1.0.0",
  "description": "Sends the currently playing YouTube video title and channel to your local OBS study overlay.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}